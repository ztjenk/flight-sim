#
# Regression test entry point. Runs the harness under conda env 'devenv' when
# available (falls back to the ambient python3 otherwise). Exits nonzero on any
# build error, Fortran assert failure, or golden mismatch.
#
#   ./run_tests            # build + assert + trim/linearization diff
#   ./run_tests --bless    # regenerate goldens from current trusted output
set -euo pipefail
cd "$(dirname "$0")"

PY=python3
if command -v conda >/dev/null 2>&1; then
  # activate devenv non-interactively if it exists
  CONDA_BASE="$(conda info --base 2>/dev/null || true)"
  if [[ -n "${CONDA_BASE}" && -f "${CONDA_BASE}/etc/profile.d/conda.sh" ]]; then
    # shellcheck disable=SC1091
    source "${CONDA_BASE}/etc/profile.d/conda.sh"
    if conda env list | grep -qE '(^|/)devenv[[:space:]]'; then
      conda activate devenv
    fi
  fi
fi

exec "$PY" regression.py "$@"
