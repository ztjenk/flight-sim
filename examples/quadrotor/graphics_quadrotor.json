{
    "_note": "Self-contained quadrotor graphics config. rust_enabled=true on BOTH udp (physics) and pilot_controls (controller), so running graphics from this directory launches everything: physics + the quad PID controller. Pilot commands come from an Xbox gamepad over UDP 6000. Run:  cd examples/quadrotor && ../../graphics/target/release/flightsim_graphics graphics_quadrotor.json",
    "camera": {
        "view_plane": { "distance[ft]": 1.0, "angle[deg]": 60.0, "aspect_ratio": 2.0 },
        "fix_to": "body",
        "location[ft]": [-3.0, 0.0, -1.0],
        "orientation[deg]": [0.0, -10.0, 0.0]
    },
    "ground": {
        "mode": "grid",
        "altitude[ft]": 0.0,
        "grid_scale[ft]": 1000.0,
        "color": "black",
        "max_draw_distance[ft]": 50000
    },
    "vehicle": {
        "stl_files": {
            "main": { "is_main": true, "file": "meshes/simplequad/simplequad.stl" }
        },
        "control_surfaces": {
            "order": [
                "skipthis", "ub", "vb", "wb",
                "skipthis", "skipthis", "skipthis",
                "xf", "yf", "zf",
                "e0", "ex", "ey", "ez",
                "skipthis", "skipthis", "skipthis", "skipthis"
            ],
            "note": "udp packet order received from physics (quad: state only, no aero surfaces)",
            "precision": "single"
        },
        "control_surface_units": "radians",
        "color": "orange",
        "default_location[ft]": [0.0, 0.0, -5000.0],
        "default_orientation[deg]": [0.0, 0.0, 0.0],
        "scale": 1.0
    },
    "udp": {
        "enable_udp": true,
        "port_id": 5005,
        "rust_enabled": true,
        "physics_exe": "../../physics/src/bin/flightsim",
        "physics_json": "sim_quadrotor.json",
        "physics_path": "."
    },
    "pilot_controls": {
        "enable_pilot_cmd": true,
        "udp_port_id": 6000,
        "rate_hz": 100,
        "rust_enabled": true,
        "controller_exe": "../../controllers/src_quadrotorPID/bin/quadPID",
        "controller_json": "controller_quadrotor.json",
        "controller_path": "."
    },
    "background": { "color": "light_gray" },
    "sky": {
        "enabled": false,
        "sun_direction": [0.0, 0.0, -1.0],
        "sun_intensity": 30.0,
        "sun_angular_radius_deg": 0.53,
        "ground_albedo": 0.9,
        "exposure": 3.0
    },
    "hud": {
        "enable": true,
        "color": "lime",
        "opacity": 0.8,
        "font_size": 16.0
    }
}
