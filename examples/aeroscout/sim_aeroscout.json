        "type": "trim",
        "state": {
          "angle_of_attack[deg]": 0.0,
          "sideslip_angle[deg]": 0.0,
          "p[deg/s]": 0.0,
          "q[deg/s]": 0.0,
          "r[deg/s]": 0.0,
          "control_effectors": {
            "aileron[deg]": 0.0,
            "elevator[deg]": 0.0,
            "rudder[deg]": 0.0,
            "throttle": 0.5
          }
        },
        "trim": {
          "type": "sct",
          "fixed_climb_angle[deg]": 0.0,
          "climb_angle_notes": "doesn't account for wind. if provided, code solves for theta given climb angle",
          "xsideslip_angle[deg]": -10.0,
          "sideslip_angle_note": "if user wishes to solve shss with a given beta instead of given phi (comment out to solve for beta)",
          "xload_factor": 1.2,
          "loadfactornote": "used for sct if given. Finds phi to match load factor",
          "vbr_pw[deg/s]": 30.0,
          "vbr_direction": 1,
          "vbr_note": "p_w used to specify roll rate in the wind axis. vbr_direction: 1: up, -1: down",
          "solver": {
            "finite_difference_step_size": 0.01,
            "relaxation_factor": 0.7,
            "tolerance": 1e-13,
            "max_iterations": 2000,
            "verbose": true
          }
        }
      }
    }
  },
  "connections": {
    "graphics_send": {
      "note": "channel to send aircraft state to graphics code",
      "enabled": true,
      "channel_type": "udp",
      "vehicle": "Aeroscout",
      "type": "send",
      "IP_address": "127.0.0.1",
      "port_ID": 5005,
      "double_precision": false,
      "refresh_rate": 100
    },
    "controller_send": {
      "note": "channel to send aircraft state to controller code",
      "enabled": true,
      "channel_type": "udp",
      "vehicle": "Aeroscout",
      "type": "send",
      "IP_address": "127.0.0.1",
      "port_ID": 5001,
      "double_precision": true,
      "refresh_rate": 100,
      "entity_tagged": false
    },
    "controller_receive": {
      "note": "channel to receive commanded controls from controller code",
      "enabled": true,
      "channel_type": "udp",
      "vehicle": "Aeroscout",
      "type": "receive",
      "IP_address": "127.0.0.1",
      "data_type": "controls",
      "port_ID": 5002,
      "double_precision": true,
      "wait_for_input": true,
      "waitforinputnote": "true uses blocking (sim waits for controller), false uses nonblocking",
      "refresh_rate": 100,
      "entity_tagged": false
    }
  }
